import pytest
from unittest.mock import MagicMock, patch, Mock
from app.services.kfp_service import KFPService

@pytest.fixture
def kfp_service():
    # Clear sys.modules for kfp to ensure mocks work if needed, 
    # but here we just want to test the KFPService class.
    return KFPService()

def test_get_client_success(kfp_service):
    with patch("kfp.Client") as mock_client_class:
        mock_instance = MagicMock()
        mock_client_class.return_value = mock_instance
        
        # Mock the internal API clients for _inject_auth_headers
        mock_api_client = MagicMock()
        mock_instance.pipelines_api = MagicMock(api_client=mock_api_client)
        mock_api_client.default_headers = {}
        
        client = kfp_service.get_client()
        assert client == mock_instance
        assert mock_client_class.called
        # Check header injection
        assert 'kubeflow-userid' in mock_api_client.default_headers

def test_get_client_failure(kfp_service):
    with patch("kfp.Client", side_effect=Exception("Connection refused")):
        client = kfp_service.get_client()
        assert client is None

@pytest.mark.asyncio
async def test_trigger_ingestion_success(kfp_service):
    mock_client = MagicMock()
    mock_run = MagicMock()
    mock_run.run_id = "test-run-id"
    mock_client.create_run_from_pipeline_package.return_value = mock_run
    
    with patch.object(kfp_service, "get_client", return_value=mock_client):
        with patch("kfp.compiler.Compiler.compile") as mock_compile:
            # We also need to mock the ingestion_pipeline import
            # Since it might not exist in the test environment or is heavy
            with patch("kubeflow.pipelines.ingestion.pipeline.ingestion_pipeline", MagicMock(), create=True):
                result = await kfp_service.trigger_ingestion(bucket="test-bucket")
                
                assert result["status"] == "success"
                assert result["run_id"] == "test-run-id"
                assert mock_compile.called
                assert mock_client.create_run_from_pipeline_package.called

@pytest.mark.asyncio
async def test_trigger_ingestion_connection_failed(kfp_service):
    with patch.object(kfp_service, "get_client", return_value=None):
        result = await kfp_service.trigger_ingestion()
        assert result["status"] == "error"
        assert "KFP connection failed" in result["message"]

@pytest.mark.asyncio
async def test_trigger_ingestion_auth_fallback(kfp_service):
    mock_client = MagicMock()
    mock_client.create_run_from_pipeline_package.side_effect = Exception("Unauthorized")
    
    with patch.object(kfp_service, "get_client", return_value=mock_client):
        with patch("kfp.compiler.Compiler.compile"):
            with patch("kubeflow.pipelines.ingestion.pipeline.ingestion_pipeline", MagicMock(), create=True):
                result = await kfp_service.trigger_ingestion()
                assert result["status"] == "redirect"
                assert "KFP Auth required" in result["message"]
