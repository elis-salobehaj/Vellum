# Backend Configuration
PROJECT_NAME=Vellum
API_V1_STR=/api/v1

# Authentication (Microsoft Entra ID)
AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET
AZURE_AUTHORITY=https://login.microsoftonline.com/common

# Security Controls
BYPASS_AUTH=False
VITE_BYPASS_AUTH=false

# LLM Providers
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
AWS_BEDROCK_API_KEY=YOUR_AWS_BEDROCK_API_KEY


# Vector Database
VECTOR_STORE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Frontend Specific (Passed as Build Args)
VITE_API_URL=/api/v1
VITE_AZURE_TENANT_ID=common
VITE_AZURE_CLIENT_ID=${AZURE_CLIENT_ID}
VITE_AZURE_AUTHORITY=${AZURE_AUTHORITY}

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDINGS_SERVICE_URL=http://embeddings-service.kubeflow-vellum/v1
OLLAMA_BASE_URL=http://ollama:11434

# Local / Hybrid Overrides (Merged from backend/.env)
# These point to localhost ports forwarded by ./scripts/connect.sh
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=documents
LLM_SERVICE_URL=http://localhost:8081/v1
KFP_HOST=http://localhost:8888
# Override Embeddings for local dev (was pointing to K8s DNS)
EMBEDDINGS_SERVICE_URL=http://localhost:8082/v1
QDRANT_COLLECTION=vellum
